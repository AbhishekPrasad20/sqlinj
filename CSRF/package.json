{
  "name": "csrf-banking-demo",
  "version": "1.0.0",
  "description": "Educational demo of CSRF – vulnerable vs. secure mode",
  "main": "victim/server.js",
  "scripts": {
    "start": "SET MODE=vulnerable && node victim/server.js",
    "start:secure": "SET MODE=secure && node victim/server.js",
    "attacker": "node attacker/server.js",
    "dev": "concurrently \"npm run start\" \"npm run attacker\""
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "concurrently": "^8.2.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "uuid": "^9.0.1"
  }
}